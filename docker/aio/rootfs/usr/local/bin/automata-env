# Sourced (never executed) by every s6 script in the all-in-one image. The one
# place each derived variable is written, so the web app, Evolution and the
# bridge cannot disagree about a port, a URL or a secret — the job
# docker-compose.yml's `environment:` blocks do for the multi-container setup.
#
# Reads the container's environment (s6 scripts run under with-contenv) and the
# secrets init-data generated in /data/secrets. An empty variable counts as
# unset, so `docker run --env-file .env` with .env.selfhost.example's blank
# lines falls back to the generated value rather than to "".

AUTOMATA_DATA=/data
AUTOMATA_SECRETS=$AUTOMATA_DATA/secrets

# Internal ports. Off the usual 8080/8095 because the web app follows $PORT and
# platforms inject PORT=8080; the web run script refuses a PORT equal to any.
AUTOMATA_PG_PORT=5432
AUTOMATA_REDIS_PORT=6379
AUTOMATA_EVOLUTION_PORT=18080
AUTOMATA_BRIDGE_PORT=18095
AUTOMATA_WEB_PORT=${PORT:-3000}

# The secrets init-data generates. An environment variable of the same name wins
# over the stored file, and is never written back to it.
AUTOMATA_SECRET_NAMES="POSTGRES_PASSWORD WEBHOOK_SECRET EVOLUTION_API_KEY TELEGRAM_BRIDGE_ADMIN_KEY TELEGRAM_SESSION_ENCRYPTION_KEY"

automata_secret() {
  local name=$1
  if [ -n "${!name:-}" ]; then
    printf '%s' "${!name}"
  elif [ -r "$AUTOMATA_SECRETS/$name" ]; then
    cat "$AUTOMATA_SECRETS/$name"
  fi
}

POSTGRES_DB=${POSTGRES_DB:-automata}
POSTGRES_USER=${POSTGRES_USER:-automata}
POSTGRES_PASSWORD=$(automata_secret POSTGRES_PASSWORD)
WEBHOOK_SECRET=$(automata_secret WEBHOOK_SECRET)
EVOLUTION_API_KEY=$(automata_secret EVOLUTION_API_KEY)
TELEGRAM_BRIDGE_ADMIN_KEY=$(automata_secret TELEGRAM_BRIDGE_ADMIN_KEY)
TELEGRAM_SESSION_ENCRYPTION_KEY=$(automata_secret TELEGRAM_SESSION_ENCRYPTION_KEY)

# Literal 127.0.0.1, never `localhost`: net-guard resolves these URLs to the
# addresses it refuses as this deployment's own backends, and localhost may
# resolve to ::1 alone.
AUTOMATA_DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:$AUTOMATA_PG_PORT/$POSTGRES_DB"

# ── web ──────────────────────────────────────────────────────────────────────
export NUXT_DATABASE_URL=$AUTOMATA_DATABASE_URL
export NUXT_PUBLIC_APP_URL=${NUXT_PUBLIC_APP_URL:-http://localhost:$AUTOMATA_WEB_PORT}
export NUXT_WEBHOOK_SECRET=$WEBHOOK_SECRET

export NUXT_EVOLUTION_URL=http://127.0.0.1:$AUTOMATA_EVOLUTION_PORT
export NUXT_EVOLUTION_ADMIN_KEY=$EVOLUTION_API_KEY
export NUXT_EVOLUTION_DATABASE_URL=$AUTOMATA_DATABASE_URL
export NUXT_WEBHOOK_URL=http://127.0.0.1:$AUTOMATA_WEB_PORT/api/webhook/evolution

export NUXT_TELEGRAM_URL=http://127.0.0.1:$AUTOMATA_BRIDGE_PORT
export NUXT_TELEGRAM_ADMIN_KEY=$TELEGRAM_BRIDGE_ADMIN_KEY
export NUXT_TELEGRAM_DATABASE_URL=$AUTOMATA_DATABASE_URL
export NUXT_TELEGRAM_WEBHOOK_URL=http://127.0.0.1:$AUTOMATA_WEB_PORT/api/webhook/telegram

# Same un-prefixed names as .env.selfhost.example. A NUXT_ name set directly
# still wins.
export NUXT_SMTP_HOST=${NUXT_SMTP_HOST:-${SMTP_HOST:-}}
export NUXT_SMTP_PORT=${NUXT_SMTP_PORT:-${SMTP_PORT:-587}}
export NUXT_SMTP_USERNAME=${NUXT_SMTP_USERNAME:-${SMTP_USERNAME:-}}
export NUXT_SMTP_PASSWORD=${NUXT_SMTP_PASSWORD:-${SMTP_PASSWORD:-}}
export NUXT_SMTP_TLS=${NUXT_SMTP_TLS:-${SMTP_TLS:-false}}
export NUXT_MAIL_FROM=${NUXT_MAIL_FROM:-${MAIL_FROM:-}}
export NUXT_MAIL_FROM_NAME=${NUXT_MAIL_FROM_NAME:-${MAIL_FROM_NAME:-Automata MCP}}
export NUXT_SIGNUP=${NUXT_SIGNUP:-${SIGNUP:-invite-only}}
export NUXT_SIGNUP_CODE=${NUXT_SIGNUP_CODE:-${SIGNUP_CODE:-}}
export NUXT_EMAIL_VERIFICATION=${NUXT_EMAIL_VERIFICATION:-${EMAIL_VERIFICATION:-auto}}

# ── Evolution (mirrors the evolution service in docker-compose.yml) ──────────
export SERVER_TYPE=http
export SERVER_PORT=$AUTOMATA_EVOLUTION_PORT
export SERVER_URL=http://127.0.0.1:$AUTOMATA_EVOLUTION_PORT
export TELEMETRY_ENABLED=false
export LOG_LEVEL=ERROR,WARN,INFO,LOG
export LANGUAGE=en
export DEL_INSTANCE=false
export QRCODE_LIMIT=30

export AUTHENTICATION_API_KEY=$EVOLUTION_API_KEY
export AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

export DATABASE_PROVIDER=postgresql
export DATABASE_CONNECTION_URI="$AUTOMATA_DATABASE_URL?schema=public"
export DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
export DATABASE_SAVE_DATA_INSTANCE=true
export DATABASE_SAVE_DATA_NEW_MESSAGE=true
export DATABASE_SAVE_MESSAGE_UPDATE=true
export DATABASE_SAVE_DATA_CONTACTS=true
export DATABASE_SAVE_DATA_CHATS=true
# The history WhatsApp hands over once, at pairing. False drops it for good.
export DATABASE_SAVE_DATA_HISTORIC=true

export CACHE_REDIS_ENABLED=true
export CACHE_REDIS_URI=redis://127.0.0.1:$AUTOMATA_REDIS_PORT/6
export CACHE_REDIS_PREFIX_KEY=evolution
export CACHE_REDIS_SAVE_INSTANCES=false
export CACHE_LOCAL_ENABLED=false

# Off: the app registers a webhook per connection, and with both on every event
# arrives twice.
export WEBHOOK_GLOBAL_ENABLED=false

# ── Telegram bridge ──────────────────────────────────────────────────────────
export TELEGRAM_BRIDGE_PORT=$AUTOMATA_BRIDGE_PORT
export TELEGRAM_BRIDGE_ADMIN_KEY
export TELEGRAM_SESSION_ENCRYPTION_KEY
export TELEGRAM_BRIDGE_DATABASE_URL=$AUTOMATA_DATABASE_URL
