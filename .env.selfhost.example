# Self-hosting with docker-compose.yml. Copy to `.env` and fill in the blanks.
# (For development, use .env.example with docker-compose.dev.yml instead.)
#
# The all-in-one image reads the same names: `docker run --env-file .env …`.
# There every secret below is optional — blank ones are generated on first boot
# and kept in the /data volume. See docs/self-hosting.md, "Single container".
#
# Generate every secret at once:
#   for k in POSTGRES_PASSWORD WEBHOOK_SECRET EVOLUTION_API_KEY TELEGRAM_BRIDGE_ADMIN_KEY TELEGRAM_SESSION_ENCRYPTION_KEY; do
#     echo "$k=$(openssl rand -hex 32)"; done >> .env

# ── Required ─────────────────────────────────────────────────────────────────

# The address people open the app at. Connector URLs are built from it, so get
# it wrong and every token you hand out points at the wrong host.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Database password. Its backups hold every stored credential. URL-safe
# characters only (openssl rand -hex 32) — it is spliced into a database URL.
# With Compose, set it before the first start: changing it later also needs an
# ALTER ROLE in Postgres.
POSTGRES_PASSWORD=

# Authenticates Evolution's and the Telegram bridge's webhooks to the app.
WEBHOOK_SECRET=

# Evolution API's global key. Required even without WhatsApp; it is the most
# sensitive value here — it can read and send from every paired account.
EVOLUTION_API_KEY=

# Host port for the web app.
WEB_PORT=3000

# ── Sign-up (optional) ───────────────────────────────────────────────────────
# Unset = invite-only: the first account on an empty database gets through and
# becomes admin; everyone after joins by invitation link. `open` lets anyone
# who finds the URL create an account and an organization. SIGNUP_CODE, in
# invite-only mode, lets its holder create their own organization — and is then
# required for the first account too. See docs/self-hosting.md "Who can sign up".

SIGNUP=
SIGNUP_CODE=
# Email verification: `auto` (unset; on when SMTP_HOST is set), `required` or
# `off`. See docs/self-hosting.md "Email verification".
EMAIL_VERIFICATION=

# ── Private targets (optional) ───────────────────────────────────────────────
# `true` lets connections reach private and loopback addresses — a database on
# your LAN, say. Deployment-wide. Never pair it with SIGNUP=open: any stranger
# who signs up could then reach your private network. The app's own Postgres,
# Evolution and bridge stay refused either way. See docs/self-hosting.md.
ALLOW_PRIVATE_TARGETS=

# ── Telegram (only with --profile telegram) ──────────────────────────────────

# From https://my.telegram.org → API development tools. Both or neither.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BRIDGE_ADMIN_KEY=
# Losing this unlinks every Telegram account. Keep a copy somewhere else.
TELEGRAM_SESSION_ENCRYPTION_KEY=

# ── Mail (optional) ──────────────────────────────────────────────────────────
# Alerts, invitations, email verification and password reset. Empty SMTP_HOST
# = none delivered: verification (auto) is off and "Forgot password?" is
# unavailable.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# false = STARTTLS on 587; true = implicit TLS on 465
SMTP_TLS=false
MAIL_FROM=
MAIL_FROM_NAME=Automata MCP
# Optional: where reconnect loops and stuck sessions on this deployment's
# Evolution are reported, so whoever can restart it hears about them. Needs SMTP.
OPS_ALERT_EMAIL=

# ── MCP rate limits (optional) ───────────────────────────────────────────────
# Requests per minute; 0 turns a budget off. Empty = the default shown.
# See docs/self-hosting.md "MCP rate limits".

MCP_RATE_TOKEN_PER_MINUTE=120
MCP_RATE_ORG_PER_MINUTE=600
MCP_RATE_EXPENSIVE_PER_MINUTE=30
# Optional: shares rate-limit counts and short-lived caches across web
# replicas. Empty = kept in each process, right for one replica. If it is a
# Redis something else uses, give it a database of its own (e.g. /1).
REDIS_URL=
