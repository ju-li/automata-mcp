# ─────────────────────────────────────────────────────────────────────────────
# Single env file for the whole repo.
#
#   • docker-compose.dev.yml reads it automatically (it sits next to this file).
#   • Nuxt reads it because apps/web scripts pass `--dotenv ../../.env`.
#
# Copy to `.env` and fill in. On Railway you do NOT ship a .env — set the
# NUXT_* vars in each service's dashboard instead.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Webhook (Evolution -> this app) ──────────────────────────────────────────
# WEBHOOK_URL and NUXT_WEBHOOK_URL MUST hold the same value. Two names because
# compose and Nuxt read env differently (Nuxt only overrides runtimeConfig from
# NUXT_-prefixed vars). This pair is the only thing that differs between dev and
# prod — no code changes.
#
#   dev  : http://host.docker.internal:3000/api/webhook/evolution
#          (host.docker.internal resolves via the `extra_hosts` entry on the
#           evolution service; Linux needs it declared explicitly)
#   prod : https://<your-app>.up.railway.app/api/webhook/evolution
#
# NUXT_WEBHOOK_URL is the one the app registers with Evolution, per connection,
# so it matters whether or not you run the WhatsApp stack in compose. WEBHOOK_URL
# is only the global fallback and is disabled by default — see the webhook block
# on the evolution service in docker-compose.dev.yml.
#
# This is what makes a disconnect show up in seconds rather than at the next
# five-minute sweep. Unset, alerting still works; it is just slower.
WEBHOOK_URL=http://host.docker.internal:3000/api/webhook/evolution
NUXT_WEBHOOK_URL=http://host.docker.internal:3000/api/webhook/evolution

# Shared secret this app checks on inbound webhook requests. Evolution v2 has no
# built-in webhook signing, so the app compares this against an `x-webhook-secret`
# header it attaches when it registers each connection's webhook.
#
# Set it. This app registers per-instance webhooks, which do send custom headers.
# (The historical warning was about the *global* webhook, which sends none — a
# value here made every global delivery 401, and Evolution drops a 401 rather
# than retrying. That webhook is off now.)
#
# Left empty, the inbound route is unauthenticated. It survives that: a delivery
# is only ever a hint, and the app re-reads the connection's live state from
# Evolution before it acts on one.
#
# Generate: openssl rand -hex 32
NUXT_WEBHOOK_SECRET=


# ── Postgres ─────────────────────────────────────────────────────────────────
# One Postgres serves the whole deployment: the app's own tables (schema `app`),
# Evolution's (`public`) and the Telegram bridge's (`telegram`). It is not the
# database a user connects Claude to. These three are read by compose to stand
# it up. Optional; the defaults below are what compose uses.
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evolution

# The app's own database: users, sessions, organizations, connections and their
# credentials, connector tokens. The app creates the `app` schema and migrates it
# at boot, so this role needs CREATE on the database (or the schema must already
# exist and be its own). Read-write, and it holds every secret the app has —
# never reuse the read-only URL below for it. Always refused as a user-supplied
# connection target, whatever NUXT_ALLOW_PRIVATE_TARGETS says.
# Required.
NUXT_DATABASE_URL=postgres://evolution:change-me@localhost:5432/evolution

# Read-only connection behind `read-messages` and `search-messages`. Required if
# you want WhatsApp connections at all — without it neither tool can answer,
# though pairing and sending still work. Not needed for database connections.
#
# It names ONE database: the one belonging to the Evolution server configured
# below. A connection that brings its own Evolution server keeps its messages in
# that server's database, and supplies its own URL for it when it is created (or
# from its dashboard afterwards) — stored per connection, not here. Until it
# does, reads for that account answer 501 naming the missing setting rather than
# matching nothing and reporting an empty conversation.
#
# Two reasons it exists. Evolution 2.3.7 has no message-content search: its
# findMessages accepts a `where.message` and then ignores it, returning
# unfiltered results. And it stores a message more than once across a re-pair,
# with the copies disagreeing about the sender's name; collapsing them has to
# happen before the page is cut, which means SQL. See docs/whatsapp.md.
#
# The same URL as NUXT_DATABASE_URL works: the app only ever runs fixed,
# parameterised SELECTs here, and opens these sessions read-only. A dedicated
# SELECT-only role is optional hardening — see docs/whatsapp.md "Reading and searching
# messages" for the GRANTs and what it does and does not buy.
NUXT_EVOLUTION_DATABASE_URL=postgres://evolution:change-me@localhost:5432/evolution


# ── Evolution API (optional — only for WhatsApp connections) ─────────────────
# Everything in this section is optional. With none of it set the app still runs
# and still serves database connections; the WhatsApp create flow then requires
# the user to supply their own Evolution server URL and global key.
#
# Global admin key for the Evolution instance itself. Read by compose as
# AUTHENTICATION_API_KEY. This is NOT the token Claude uses — see MCP below.
# Generate: openssl rand -hex 16
EVOLUTION_API_KEY=

# What Evolution reports as its own public URL (used in QR/media links it emits).
# Defaults to http://localhost:8080.
EVOLUTION_SERVER_URL=http://localhost:8080

# The DEFAULT Evolution server: where the Nuxt app reaches Evolution, and the key
# it uses to create and delete instances on it. NUXT_EVOLUTION_ADMIN_KEY must be
# the SAME VALUE as EVOLUTION_API_KEY above — it is Evolution's global key.
#
# It is used only for instance provisioning. Every other Evolution call is made
# with the per-instance token Evolution issues at create time, which it scopes to
# that one instance. The global key is never written to a user-visible record,
# and it is never sent to a server a user supplied.
#
# Leave both empty to run without a default server. A user can still create a
# WhatsApp connection by supplying their own URL and key in the create form.
NUXT_EVOLUTION_URL=http://localhost:8080
NUXT_EVOLUTION_ADMIN_KEY=


# ── Telegram bridge (optional — only for Telegram connections) ───────────────
# apps/telegram-bridge links personal Telegram accounts by QR code and keeps
# their chats in its own Postgres database. Everything here is optional; with
# none of it set the app runs as before. Bring it up with
# `pnpm services:up:telegram`, or run it on the host with `pnpm bridge:dev`.
#
# Your own api_id and api_hash, from https://my.telegram.org -> API development
# tools. Never one copied from an example or another project: Telegram answers
# API_ID_PUBLISHED_FLOOD for published credentials, and logins through an
# unofficial client are watched more closely than official ones.
#
# Both or neither. With neither, the bridge runs without Telegram: routes that
# need it answer 503 `telegram_not_configured`, and the app says what to set.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The bridge's global key. Creates and deletes sessions; it does not open a
# session. Generate: openssl rand -hex 24
TELEGRAM_BRIDGE_ADMIN_KEY=

# Seals every stored Telegram session, and each one is full access to that
# account. Changing or losing it unlinks every account (each needs a new QR
# scan); leaking it together with a database backup hands over every account.
# Generate: openssl rand -hex 32
TELEGRAM_SESSION_ENCRYPTION_KEY=

# The bridge's database: the same Postgres database and credential Evolution
# uses. The bridge creates a `telegram` schema there on first start and keeps
# every table in it, so nothing mixes with Evolution's tables in `public`. This is
# the value for `pnpm bridge:dev` on the host; compose builds its own from the
# POSTGRES_* values above. On Railway it is the Postgres service's DATABASE_URL.
TELEGRAM_BRIDGE_DATABASE_URL=postgresql://evolution:change-me@localhost:5432/evolution

# Telegram's test servers instead of production. Development only: test accounts
# use phone numbers 99966XYYYY (X = DC 1-3, login code XXXXX) and live in a
# separate environment from real ones.
TELEGRAM_TEST_SERVERS=false

# The bridge's port. Unset, it follows PORT, then defaults to 8095.
# TELEGRAM_BRIDGE_PORT=8095

# How far back a newly linked account's history is fetched, per chat. Backfill
# is deliberately slow — one page of 100 at a time, spaced by the delay below,
# paused whenever Telegram asks it to wait — because an unofficial client that
# hammers history is how an account gets restricted. Live messages are synced
# in full regardless of these. Broadcast channels are skipped by default: they
# are often huge and rarely what anyone wants Claude to read.
TELEGRAM_BACKFILL_MAX_PER_CHAT=2000
TELEGRAM_BACKFILL_DAYS=365
TELEGRAM_BACKFILL_BROADCAST=false
TELEGRAM_BACKFILL_PAGE_DELAY_MS=1000

# Where the Nuxt app reaches the deployment's bridge, and that bridge's admin
# key — the SAME VALUE as TELEGRAM_BRIDGE_ADMIN_KEY. The admin key only creates
# and deletes sessions; every call made for a connection uses that connection's
# own session key, and neither is ever sent to a bridge a user supplied.
NUXT_TELEGRAM_URL=http://localhost:8095
NUXT_TELEGRAM_ADMIN_KEY=

# The bridge's database, behind list-telegram-chats, read-telegram-messages and
# search-telegram-messages: normally the same URL as TELEGRAM_BRIDGE_DATABASE_URL.
# The app reads only the `telegram` schema. To give it less than that credential,
# create a role with LOGIN and nothing else, set TELEGRAM_READER_ROLE to its name
# on the bridge (which grants it SELECT on synced data at every start), and use
# that role here.
NUXT_TELEGRAM_DATABASE_URL=postgresql://evolution:change-me@localhost:5432/evolution
# On the bridge: the LOGIN role described above. Unset, nothing is granted.
# TELEGRAM_READER_ROLE=

# Where the bridge posts connection events, so a Telegram disconnect alert goes
# out in seconds rather than at the next five-minute sweep. Unset, the app uses
# NUXT_PUBLIC_APP_URL + /api/webhook/telegram, which is right in production. In
# development the bridge runs in a container, where localhost is not this host.
# Deliveries carry NUXT_WEBHOOK_SECRET as x-webhook-secret, like Evolution's.
NUXT_TELEGRAM_WEBHOOK_URL=http://host.docker.internal:3000/api/webhook/telegram


# ── Email (IMAP) connections ─────────────────────────────────────────────────
# Optional tuning. Headers sync every two minutes; bodies and attachments are
# fetched from the mail server on request and never stored. See docs/imap.md.
# How far back the header sync reaches, and how many emails per folder.
NUXT_IMAP_BACKFILL_DAYS=365
NUXT_IMAP_BACKFILL_MAX=50000
# Largest attachment get-email-attachment will fetch, in bytes.
NUXT_IMAP_ATTACHMENT_MAX_BYTES=10485760


# ── Outbound host guard ──────────────────────────────────────────────────────
# A user-supplied Postgres connection string, Evolution URL, Telegram bridge URL
# or IMAP server is an outbound connection to an address a user chose. By default this server
# refuses one that resolves to a private or loopback address — otherwise
# `postgres://...@postgres:5432/evolution` pasted into the connection form
# reaches this deployment's own database, which holds every user's messages.
#
# Set this to true for local development and for a single-tenant, self-hosted
# deployment, where reaching a private address is the point. Do NOT set it on
# anything shared: it lets one user's connection reach your own backends.
#
# Independent of this setting, a target that resolves to this deployment's own
# database, Evolution, Evolution database, Telegram bridge or Telegram bridge
# database is always refused.
#
# The check runs whenever a connection is opened, not only when it was saved, so
# turning this off stops connections that already point at a private address from
# working. That is the intended direction — a hostname can be re-pointed after it
# passed once — but it means flipping it is not a no-op on an existing install.
NUXT_ALLOW_PRIVATE_TARGETS=true

# Who may create an account without an invitation: `open` or `invite-only`.
# Unset means invite-only, which still lets the first account on an empty
# database through, so a new deployment works with neither variable set.
# Invitations work in every mode. Open here because development signs up
# throwaway accounts; never pair `open` with NUXT_ALLOW_PRIVATE_TARGETS=true on
# anything reachable from the internet — every stranger who signs up can then
# point the server at hosts on your network.
NUXT_SIGNUP=open
# Invite-only mode only, optional: a shared code that lets whoever holds it sign
# up and create their own organization. When set, the first account needs it
# too, so nobody claims a fresh public install before you. Generate with
# `openssl rand -base64 24`.
NUXT_SIGNUP_CODE=
# Prove an address before it becomes someone's sign-in — at signup, invited
# signup, and email change — with a mailed code and link. `auto` (default) is on
# when NUXT_SMTP_HOST is set; `required` refuses signups while mail is not
# configured; `off` skips it. Anything else is read as `required`. Without it,
# anyone can register an address they do not own ahead of its owner.
NUXT_EMAIL_VERIFICATION=auto


# ── Hosted offering only ─────────────────────────────────────────────────────
# Leave these unset on a self-hosted deployment: no plan picker, no Billing page,
# no limits, no account events. On the hosted deployment they point the web app
# at the cloud service (apps/cloud), which sells plans and owns Stripe. See
# docs/billing.md.
NUXT_CLOUD_URL=
NUXT_CLOUD_ADMIN_KEY=
# NUXT_BILLING is the old switch and is deprecated. Set without NUXT_CLOUD_URL
# it fails closed: plans stay enforced and the Billing page answers 503.

# The cloud service itself (`pnpm cloud:dev`), for working on it locally.
# CLOUD_ADMIN_KEY must equal NUXT_CLOUD_ADMIN_KEY above.
CLOUD_ADMIN_KEY=
CLOUD_DATABASE_URL=
APP_URL=http://localhost:3000
# Unset, the cloud service follows PORT, then defaults to 8096.
# CLOUD_PORT=8096
# All four or none. None: the service still writes limits; starting Pro answers 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_SEAT=
# The Brevo CRM sync. All three or none. See "CRM (Brevo)" in docs/billing.md.
BREVO_API_KEY=
BREVO_PRODUCT_LIST=
BREVO_MARKETING_LIST=
# Only for pointing the sync at a local stub: BREVO_API_URL=http://localhost:8097/v3


# ── Mail ─────────────────────────────────────────────────────────────────────
# SMTP for connection alerts and invitation emails, sent from the Nuxt server.
# All optional. With NUXT_SMTP_HOST empty nothing is sent: alerts are computed
# and stay queued, and an invitation's link is still shown to copy.
#
# NUXT_SMTP_TLS=false sends STARTTLS when the server offers it, which is what port
# 587 wants; set it true for implicit TLS on 465. NUXT_MAIL_FROM is the From:
# address and must be one the SMTP provider will accept.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USERNAME=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_TLS=false
NUXT_MAIL_FROM=
NUXT_MAIL_FROM_NAME=Automata MCP


# ── App ──────────────────────────────────────────────────────────────────────
# Public origin of this app. Used to build the MCP connector URL shown to users.
# Required.
NUXT_PUBLIC_APP_URL=http://localhost:3000
